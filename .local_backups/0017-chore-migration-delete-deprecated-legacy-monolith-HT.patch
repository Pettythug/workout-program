-// =============================================================================
-// GYMLOG — RENAME/MERGE EXERCISE
-// =============================================================================
-
-function gymlog_getBaseName(name) {
-  if (!name) return "";
-  return name
-    .replace(/^(One Arm |One Leg |Single-leg |Single Leg |Single |Alt |Alternating )/gi, '')
-    .replace(/ \(Single\)$/gi, '')
